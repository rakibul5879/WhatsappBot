modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["nano"]

[userenv]

[userenv.shared]
BOT_NAME = "Rakib AI"
OWNER_NUMBER = "8801877622094"
AI_BASE_URL = "https://openrouter.ai/api/v1"
