# Required for the main bot after running `pnpm bot:session`.
SESSION_ID=

# Phone number or full WhatsApp JID of the owner.
OWNER_NUMBER=8801XXXXXXXXX

# Display name used in logs and the command menu.
BOT_NAME=Rakib AI

# Command prefix.
PREFIX=.

# Optional settings.
AUTH_DIR=./auth_info_baileys
LOG_LEVEL=info
BAILEYS_LOG_LEVEL=silent
RECONNECT_DELAY_MS=3000

# Provider-backed URL downloads.
# The provider must accept POST JSON { "url": "...", "type": "auto|audio|video" }
# and return JSON with a media URL (url/downloadUrl/mediaUrl) or Base64 data,
# plus optional mimeType, filename, and title fields.
MEDIA_PROVIDER_URL=
MEDIA_PROVIDER_API_KEY=
MEDIA_PROVIDER_TIMEOUT_MS=60000
MEDIA_MAX_BYTES=52428800

# AI text commands (.ai, .summarize, .translate, .rewrite, .explain).
# Replit-managed OpenAI integration variables are preferred when available:
# AI_INTEGRATIONS_OPENAI_BASE_URL=
# AI_INTEGRATIONS_OPENAI_API_KEY=
# For another OpenAI-compatible provider, use AI_BASE_URL and AI_API_KEY instead.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-5.6-terra
AI_TIMEOUT_MS=45000
AI_MAX_COMPLETION_TOKENS=1024

# Set this when you want the session script to use pairing code.
# Leave empty to use QR code instead.
PAIRING_NUMBER=

# Moderation settings.
SLUR_BLOCKING=true
SLUR_ACTION=delete_warn
# Optional comma-separated additions to the built-in BD slur list.
BLOCKED_WORDS=